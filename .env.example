# ========================================================
# ServiceTracker - Çevre Değişkenleri Şablonu (.env.example)
# Bu dosyayı '.env' olarak kopyalayın ve kendi ayarlarınızı girin.
# ========================================================

# Sunucu Portu
PORT=9999

# MySQL Veritabanı Bağlantısı
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=servicetracker_db

# Snipe-IT Envanter Entegrasyonu (İsteğe Bağlı)
SNIPE_URL=https://snipe.example.com
SNIPE_API_KEY=your_snipe_api_key_here

# OpenAI / Yapay Zeka Entegrasyonu (İsteğe Bağlı)
OPENAI_API_KEY=your_openai_api_key_here

# Web Push Bildirimleri (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:admin@example.com
